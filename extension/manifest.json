{
  "manifest_version": 2,
  "name": "Page AI Assistant",
  "version": "1.0.0",
  "description": "Privacy-friendly AI assistant for web pages.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "http://localhost:3000/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Page AI Assistant"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "page-ai-assistant@wibee",
      "strict_min_version": "109.0"
    }
  }
}